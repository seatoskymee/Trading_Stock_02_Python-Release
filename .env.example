# === 한국투자증권 KIS Developers API ===
# KIS Developers(https://apiportal.koreainvestment.com) 에서 발급
KIS_MODE=mock                 # mock(모의투자) 또는 real(실전투자)
KIS_APP_KEY=여기에_APP_KEY
KIS_APP_SECRET=여기에_APP_SECRET
KIS_ACCOUNT_NO=12345678-01     # 계좌번호 8자리-상품코드 2자리

# === 대시보드(웹) ===
DASHBOARD_HOST=0.0.0.0         # 폰 접속 허용하려면 0.0.0.0 유지
DASHBOARD_PORT=8089
DASHBOARD_TOKEN=               # 비워두면 인증 없음. 외부 노출 시 토큰 설정 권장

# === 결과 CSV ===
RESULT_MAX_MB=10              # 이 크기 넘으면 날짜별 백업 후 새 파일 시작

# === GitHub 자동 업데이트 ===
GITHUB_OWNER=seatoskymee       # 본인 깃허브 사용자명/조직명
GITHUB_SRC_REPO=Trading_Stock_02_Python
GITHUB_RELEASE_REPO=Trading_Stock_02_Python-Release
GITHUB_TOKEN=                  # 저장소가 private 이면 PAT 필요(repo 읽기 권한). 발급: github.com/settings/tokens

# === 매매 루프 ===
LOOP_INTERVAL_SEC=60
AUTO_START_BOT=false           # 프로그램 시작 시 매매봇 자동 시작 여부

# === 일일 목표 / 리스크 ===
DAILY_TARGET_PCT=5.0           # 당일 자산 대비 +5% 도달 시 그날 매매 중단(수익 보전)
DAILY_STOPLOSS_PCT=0           # 당일 손실 한도(%). 0이면 비활성. 예) 3 이면 -3% 도달 시 중단
HALT_ON_TARGET=true            # 목표 도달 시 자동 중단 여부
